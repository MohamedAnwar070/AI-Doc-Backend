# ── Core Settings ──────────────────────────────────────────────────────────
# OCR_ENGINE = google_docai | paddle | remote | sur_ocr | ocr_open_ai | olm_ocr | PaddleOCR1.5 | sarvam_ai
OCR_ENGINE=PaddleOCR1.5
# OCR_LANG = en | ta | auto
OCR_LANG=ta

# ── PaddleOCR-VL-1.5 ───────────────────────────────────────────────────────
PADDLE_VL_API_URL=http://localhost:8001
PADDLE_VL_API_KEY=your_paddle_vl_api_key_here
PADDLE_VL_API_TIMEOUT=3600

# ── olmOCR ─────────────────────────────────────────────────────────────────
OLM_OCR_PATH=

# ── Google Cloud Document AI ───────────────────────────────────────────────
GOOGLE_DOCAI_CREDENTIALS=google-cred/docai-key.json
GOOGLE_DOCAI_PROCESSOR=projects/your-project-id/locations/us/processors/your-processor-id
GOOGLE_DOCAI_LANGUAGE_HINTS=en,ta
GOOGLE_DOCAI_TIMEOUT=300

# ── DocAI Quality Knobs ────────────────────────────────────────────────────
GOOGLE_DOCAI_NATIVE_PDF=true
GOOGLE_DOCAI_ENABLE_NATIVE_PDF_PARSING=true
GOOGLE_DOCAI_COMPUTE_STYLE_INFO=true
GOOGLE_DOCAI_MIN_CONFIDENCE=0.50
GOOGLE_DOCAI_MAX_RETRIES=5

# ── PG Processed Translation ──────────────────────────────────────────────
GOOGLE_TRANSLATE_PROVIDER=free

# ── Processing ─────────────────────────────────────────────────────────────
MAX_WORKERS=4
USE_GPU=false
BATCH_SIZE=20
OCR_DPI=200

# ── Surya OCR CPU Optimizations ────────────────────────────────────────────
DETECTOR_BATCH_SIZE=2
RECOGNITION_BATCH_SIZE=4
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1

UVICORN_WORKERS=1

# ── Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=false

# ── Storage ────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
MAX_UPLOAD_SIZE_MB=100

# ── Layout Detection (PP-Structure) ────────────────────────────────────────
USE_LAYOUT_DETECTION=true
LAYOUT_RECOVERY=true
LAYOUT_TABLE_AS_HTML=true

# ── Translation ────────────────────────────────────────────────────────────
ENABLE_TRANSLATION=false
TRANSLATION_TARGET_LANG=en

# ── Semantic Search ────────────────────────────────────────────────────────
SEARCH_CHUNK_SIZE=1200
SEARCH_CHUNK_OVERLAP=150
SEARCH_INDEX_VERSION=4
SEARCH_EMBEDDING_CONCURRENCY=4
SEARCH_INDEX_STALE_SECONDS=300

# ── AI / LLM Integration (CHAT & ANSWERS) ──────────────────────────────────
# SWITCH_AI = ai_model | open_ai
SWITCH_AI=open_ai

OPENAI_API_KEY=your_openai_api_key_here
LLM_API_BASE_OPENAI=https://api.openai.com/v1
LLM_MODEL_OPENAI=gpt-3.5-turbo

# AI_MODEL_RUNTIME = local | remote
AI_MODEL_RUNTIME=local

AI_MODEL_LOCAL_URL=http://127.0.0.1:9081/v1
AI_MODEL_LOCAL_AUTH=
AI_MODEL_LOCAL_MODEL=Qwen3-14B-Q4_K_M.gguf
AI_MODEL_LOCAL_MAX_CONTEXT_CHARS=5000

AI_MODEL_REMOTE_URL=
AI_MODEL_REMOTE_AUTH=
AI_MODEL_REMOTE_MODEL=Qwen3-14B-Q4_K_M.gguf
AI_MODEL_REMOTE_MAX_CONTEXT_CHARS=5000

LLM_CLEAN_ENABLED=false
LLM_CLEAN_MAX_CHARS=4000

# ── Embedding (BGE-M3) ─────────────────────────────────────────────────────
EMBEDDING_RUNTIME=remote
EMBEDDING_MODEL_URL=http://localhost:8002/v1
EMBEDDING_MODEL_AUTH=
EMBEDDING_MODEL_MODEL=bge-m3
EMBEDDING_PRELOAD=false
EMBEDDING_LOCAL_MODEL_PATH=
EMBEDDING_DEVICE=cpu

# ── Native PDF Text Extraction & Database ──────────────────────────────────
NATIVE_STRIP_HEADER_PCT=0.00
NATIVE_STRIP_FOOTER_PCT=0.00
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=pdf_ocr

# ── Voice Conversation ─────────────────────────────────────────────────────
NEED_VOICE=true
VOICE_MODEL_URL=http://localhost:8003
VOICE_API_KEY=your_voice_api_key_here

# ── STT: Faster-Whisper (local fallback only) ──────────────────────────────
WHISPER_MODEL_PATH=
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ── TTS: Coqui XTTS-v2 ─────────────────────────────────────────────────────
XTTS_ENABLED=false

# ── VAD: Silero v4 ─────────────────────────────────────────────────────────
SILERO_VAD_ENABLED=true

# ── Voice Session Settings ─────────────────────────────────────────────────
VOICE_MAX_SESSION_DURATION=1800
VOICE_SILENCE_TIMEOUT=1.5
VOICE_MAX_CONTEXT_TURNS=10

# ── Auth ───────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_strong_random_secret_key
